# Skopiuj do .env lokalnie (nigdy nie commituj .env) albo ustaw te same
# nazwy jako zmienne środowiskowe w Azure App Service -> Environment variables.

# Django
SECRET_KEY=wygeneruj-dlugi-losowy-ciag-znakow
DEBUG=False
# Dodatkowe dozwolone hosty poza tymi wykrywanymi automatycznie (WEBSITE_HOSTNAME na Azure), po przecinku:
ALLOWED_HOSTS=

# Baza danych - PostgreSQL na Azure (zostaw puste lokalnie, wtedy używane jest SQLite)
DATABASE_URL=postgres://uzytkownik:haslo@nazwa-serwera.postgres.database.azure.com:5432/nazwa_bazy?sslmode=require

# Azure OpenAI (podpowiedzi opisu niezgodności, opcjonalne)
AZURE_OPENAI_ENDPOINT=https://twoj-zasob.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Wysyłka raportu z załącznikiem PDF (Azure Communication Services Email, opcjonalne)
AZURE_CONNECTION_STRING=endpoint=https://twoj-zasob.communication.azure.com/;accesskey=...
EMAIL_SENDER_ADDRESS=DoNotReply@twoja-zweryfikowana-domena.azurecomm.net

# Wymagane przez Azure App Service, żeby zbudować env z requirements.txt przy wdrożeniu
SCM_DO_BUILD_DURING_DEPLOYMENT=true
